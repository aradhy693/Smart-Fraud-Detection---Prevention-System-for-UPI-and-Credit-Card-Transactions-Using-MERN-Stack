NODE_ENV=development
PORT=5000
# REQUIRED: MongoDB connection string.
MONGO_URI=
# Require username/password in MONGO_URI. Keep true for production and Docker Compose.
REQUIRE_MONGO_AUTH=true
# REQUIRED: At least 32 chars (use 64-char hex). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# REQUIRED: Separate HMAC secret for signed double-submit CSRF tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=
# Access token lifetime. Default 15m is recommended for production.
JWT_EXPIRES_IN=15m
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
ACCESS_TOKEN_COOKIE_NAME=sfd_access_token
REFRESH_TOKEN_COOKIE_NAME=sfd_refresh_token
CSRF_COOKIE_NAME=sfd_csrf_token
COOKIE_SECURE=false
# REQUIRED: At least 16 chars. Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ADMIN_REGISTRATION_KEY=
BCRYPT_SALT_ROUNDS=12
AI_ENGINE_URL=http://localhost:8000
AI_REQUEST_TIMEOUT_MS=4500
AI_REQUEST_RETRY_ATTEMPTS=2
GEOLOCATION_URL=http://ip-api.com/json
GEOLOCATION_TIMEOUT_MS=3500
GEOLOCATION_RETRY_ATTEMPTS=2
GEOLOCATION_CACHE_TTL_MS=600000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=10
TRANSACTION_RATE_LIMIT_MAX=30
LOGIN_FAILURE_THRESHOLD=5
LOGIN_LOCKOUT_BASE_MS=900000
LOGIN_LOCKOUT_MAX_MS=86400000
LOGIN_THROTTLE_RESET_MS=3600000
IMPOSSIBLE_LOGIN_WINDOW_MS=600000
MFA_TOTP_WINDOW=2
MFA_ISSUER=Smart Fraud Detection
# REQUIRED: Shared secret between backend and AI engine. Must match AI_ENGINE_API_KEY in ai-engine/.env.
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
AI_ENGINE_API_KEY=
# REQUIRED: 64-char hex (32-byte) key used for field-level AES-256-GCM encryption.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY=
